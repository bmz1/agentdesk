{
  "name": "agentdesk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:daemon": "pnpm --filter @agentdesk/daemon dev",
    "dev:desktop": "pnpm --filter @agentdesk/desktop dev",
    "dev:web": "pnpm --filter @agentdesk/desktop dev:web",
    "agentdesk": "pnpm --silent --filter @agentdesk/cli dev",
    "seed:demo": "pnpm --filter @agentdesk/daemon seed:demo",
    "build": "pnpm --filter @agentdesk/daemon build && pnpm --filter @agentdesk/cli build && pnpm --filter @agentdesk/desktop build",
    "typecheck": "pnpm -r --no-bail typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "AGENTDESK_SMOKE=${AGENTDESK_SMOKE:-claude} vitest run apps/daemon/test/smoke.real-cli.test.ts",
    "e2e": "pnpm --filter @agentdesk/desktop e2e"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.4",
    "@types/node": "^22.20.5",
    "effect": "4.1.4",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
