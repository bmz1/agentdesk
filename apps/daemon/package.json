{
  "name": "@agentdesk/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agentdesk-daemon": "./dist/main.js"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "install-service": "tsx scripts/install-service.ts",
    "start:dist": "node dist/main.js"
  },
  "dependencies": {
    "@agentdesk/contracts": "workspace:*",
    "@agentdesk/db": "workspace:*",
    "@agentdesk/git": "workspace:*",
    "@agentdesk/harness-claude": "workspace:*",
    "@agentdesk/harness-codex": "workspace:*",
    "@agentdesk/harness-core": "workspace:*",
    "@agentdesk/harness-opencode": "workspace:*",
    "@agentdesk/jira": "workspace:*",
    "@agentdesk/workflows": "workspace:*",
    "@hono/node-server": "2.1.8",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "0.45.4",
    "effect": "4.1.4",
    "hono": "4.13.19"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
